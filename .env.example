# ============================================================
# 复制本文件为 .env，并填入自己的密钥后即可运行
#   cp .env.example .env      (Windows: copy .env.example .env)
# ============================================================

# ---- LLM：至少配置一个，程序会按顺序自动探活切换 ----
# 首选：DeepSeek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 备选：阿里云百炼（DashScope），兼容 OpenAI 协议
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 备选：硅基流动（同时用于 Qwen3-Embedding 嵌入）
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ---- 向量库：Milvus 未启动时会自动降级为关键词检索，可不配 ----
MILVUS_URI=http://localhost:19530

# ---- 链路监控：LangSmith，可选 ----
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_xxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=ai-companion
